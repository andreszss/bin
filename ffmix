#!/bin/sh

# Comprobar que se pasaron los argumentos mínimos necesarios
if [ "$#" -lt 2 ]; then
    echo "Uso: $0 <video_original> <audio_nuevo> [salida.mp4] [youtube|tiktok]"
    exit 1
fi

VIDEO="$1"
AUDIO_EXTRA="$2"
SALIDA="${3:-salida_mezclada.mp4}"
PLATAFORMA="${4:-youtube}" # Por defecto usa youtube si no se especifica

echo "Procesando video para $PLATAFORMA con ffmpeg..."

if [ "$PLATAFORMA" = "tiktok" ]; then
    # Comando optimizado para TikTok
    ffmpeg -i "$VIDEO" -i "$AUDIO_EXTRA" \
        -filter_complex "[0:a]volume=0.25[a1];[a1][1:a]amix=inputs=2:duration=first[aout]" \
        -map 0:v -map "[aout]" \
        -c:v libx264 -crf 18 -preset slow -pix_fmt yuv420p \
        -c:a aac -b:a 320k -movflags +faststart "$SALIDA"
else
    # Comando estándar (YouTube u otros)
    ffmpeg -i "$VIDEO" -i "$AUDIO_EXTRA" \
        -filter_complex "[0:a]volume=0.25[a1];[a1][1:a]amix=inputs=2:duration=first[aout]" \
        -map 0:v -map "[aout]" \
        -c:v libx264 -crf 23 -c:a aac -b:a 192k "$SALIDA"
fi

echo "¡Listo! Archivo guardado como: $SALIDA"
