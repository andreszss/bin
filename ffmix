#!/bin/sh
set -eu

# ---------- config ----------
VIDEO_VOL="0.15"   # volume of the video's own audio when mixing
EXTRA_VOL="3.5"    # volume of the extra audio
AUDIO_RATE="48000" # sample rate of the output audio

# ---------- helpers ----------
usage() {
    cat <<EOF
use: ffmix <video> [-a audio] [-o output.mp4] [-p tt|yt] [-A pcm|flac|alac|aac]

  -a  extra audio to mix in (optional)
  -o  output file (default: output.mp4)
  -p  preset: tt (crf 18, slow, faststart) or yt (crf 23)  (default: tt)
  -A  audio codec (default: pcm)
        pcm   pcm_f32le, 2ch, 48000 Hz, 3072 kbps (uncompressed, no loss)
        flac  lossless, compressed (24-bit, 2ch, 48000 Hz)
        alac  lossless, compressed (24-bit, Apple-friendly)
        aac   lossy, uses the bitrate of the preset (best for uploads)
  -h  show this help
EOF
}

die() {
    echo "error: $*" >&2
    exit 1
}

has_audio() {
    [ -n "$(ffprobe -v error -select_streams a -show_entries stream=index \
        -of csv=p=0 "$1")" ]
}

set_preset() {
    case "$1" in
        tt)
            VCODEC="-c:v libx264 -crf 18 -preset slow -pix_fmt yuv420p"
            ABITRATE="320k"
            MOVFLAGS="-movflags +faststart"
            ;;
        yt)
            VCODEC="-c:v libx264 -crf 23"
            ABITRATE="192k"
            MOVFLAGS=""
            ;;
        *) die "unknown preset '$1' (use tt or yt)" ;;
    esac
}

set_audio() {
    case "$1" in
        pcm)
            ACODEC="-c:a pcm_f32le -ar $AUDIO_RATE -ac 2"
            ;;
        flac)
            ACODEC="-c:a flac -compression_level 12 -sample_fmt s32 -ar $AUDIO_RATE -ac 2"
            ;;
        alac)
            ACODEC="-c:a alac -sample_fmt s32p -ar $AUDIO_RATE -ac 2"
            ;;
        aac)
            ACODEC="-c:a aac -b:a $ABITRATE -ar $AUDIO_RATE -ac 2"
            ;;
        *) die "unknown audio codec '$1' (use pcm, flac, alac or aac)" ;;
    esac
    # pcm/flac/alac inside .mp4 need -strict -2 on some ffmpeg versions
    case "$1" in
        pcm|flac|alac)
            STRICT="-strict -2"
            case "$OUTPUT" in
                *.mp4|*.MP4|*.m4v)
                    echo "warning: '$1' audio in .mp4 plays in VLC/mpv/ffmpeg but many" >&2
                    echo "         editors and sites reject it; use .mov or .mkv, or -A aac" >&2
                    ;;
            esac
            ;;
        *) STRICT="" ;;
    esac
}

# ---------- args ----------
[ "$#" -ge 1 ] || { usage; exit 1; }
case "$1" in -h|--help) usage; exit 0 ;; esac

VIDEO="$1"; shift
AUDIO=""
OUTPUT="output.mp4"
PRESET="tt"
ACODEC_NAME="pcm"

while getopts "a:o:p:A:h" opt; do
    case "$opt" in
        a) AUDIO="$OPTARG" ;;
        o) OUTPUT="$OPTARG" ;;
        p) PRESET="$OPTARG" ;;
        A) ACODEC_NAME="$OPTARG" ;;
        h) usage; exit 0 ;;
        *) usage; exit 1 ;;
    esac
done

# ---------- checks ----------
command -v ffmpeg  >/dev/null 2>&1 || die "ffmpeg not found"
command -v ffprobe >/dev/null 2>&1 || die "ffprobe not found"
[ -f "$VIDEO" ] || die "video not found: $VIDEO"
[ -z "$AUDIO" ] || [ -f "$AUDIO" ] || die "audio not found: $AUDIO"
set_preset "$PRESET"
set_audio "$ACODEC_NAME"

# ---------- build command ----------
set -- -hide_banner -i "$VIDEO"

if [ -n "$AUDIO" ]; then
    set -- "$@" -i "$AUDIO"
    if has_audio "$VIDEO"; then
        echo "mode: mixing extra audio with video audio"
        FILTER="[0:a]aformat=sample_rates=$AUDIO_RATE:channel_layouts=stereo,volume=$VIDEO_VOL[a1];[1:a]aformat=sample_rates=$AUDIO_RATE:channel_layouts=stereo,volume=$EXTRA_VOL[a2];[a1][a2]amix=inputs=2:duration=first[aout]"
        set -- "$@" -filter_complex "$FILTER" -map 0:v -map "[aout]"
    else
        echo "mode: video has no audio, using extra audio only"
        set -- "$@" -filter_complex "[1:a]aformat=sample_rates=$AUDIO_RATE:channel_layouts=stereo,volume=$EXTRA_VOL[aout]" \
            -map 0:v -map "[aout]" -shortest
    fi
    # shellcheck disable=SC2086
    set -- "$@" $VCODEC $ACODEC $STRICT $MOVFLAGS
elif has_audio "$VIDEO"; then
    echo "mode: no extra audio, keeping video audio"
    # shellcheck disable=SC2086
    set -- "$@" -map 0:v -map 0:a $VCODEC $ACODEC $STRICT $MOVFLAGS
else
    echo "mode: no extra audio, video has no audio"
    # shellcheck disable=SC2086
    set -- "$@" -map 0:v $VCODEC -an $MOVFLAGS
fi

# ---------- run ----------
echo "processing '$VIDEO' with '$PRESET' preset."
ffmpeg "$@" "$OUTPUT"
echo "file saved: $OUTPUT"
