#!/bin/sh
#
# bud - posix sh pywal alternative

CURRENT="$HOME/.cache/current-palette"

newline='
'

out() {
    printf '%s\n' "$1" >&2
}

img() {
    [ -d "$1" ] && {
        set +f
        set -- "$1/"*
        [ "$#" -eq 0 ] && { out "error: No images were found, exiting..."; exit 1; }
        shift "$(shuf -i "1-$#" -n 1 2>/dev/null || awk -v n="$#" 'BEGIN { srand(); print int(rand()*n)+1 }')"
        wal="$1"
    }
    [ -n "$wal" ] || wal="$1"
    [ -f "$wal" ] || { out "error: file '$wal' not found or inaccessible"; exit 1; }
    printf '%s\n' "$wal"
}

# Ajuste de colores identico a pywal16 (backends/wal.py + colors.generic_adjust)
ADJUST_AWK='
function h2d(s,  i,n) {
    n = 0; s = tolower(s)
    for (i = 1; i <= length(s); i++)
        n = n * 16 + index("0123456789abcdef", substr(s, i, 1)) - 1
    return n
}
function hex(r, g, b) { return sprintf("#%02x%02x%02x", r, g, b) }
function lighten(c, a) {
    return hex(int(h2d(substr(c,2,2)) + (255 - h2d(substr(c,2,2))) * a),
               int(h2d(substr(c,4,2)) + (255 - h2d(substr(c,4,2))) * a),
               int(h2d(substr(c,6,2)) + (255 - h2d(substr(c,6,2))) * a))
}
function darken(c, a) {
    return hex(int(h2d(substr(c,2,2)) * (1 - a)),
               int(h2d(substr(c,4,2)) * (1 - a)),
               int(h2d(substr(c,6,2)) * (1 - a)))
}
function frac(x,  f) { f = x - int(x); if (f < 0) f += 1; return f }
function hlsv(m1, m2, h) {
    h = frac(h)
    if (h < 1/6) return m1 + (m2 - m1) * h * 6.0
    if (h < 0.5) return m2
    if (h < 2/3) return m1 + (m2 - m1) * (2/3 - h) * 6.0
    return m1
}
# igual que saturate_color de pywal: fija la saturacion HLS a "amt"
function saturate(c, amt,  r, g, b, mx, mn, sm, rg, l, s, h, rc, gc, bc, m1, m2) {
    r = h2d(substr(c,2,2)) / 255.0
    g = h2d(substr(c,4,2)) / 255.0
    b = h2d(substr(c,6,2)) / 255.0
    mx = r; if (g > mx) mx = g; if (b > mx) mx = b
    mn = r; if (g < mn) mn = g; if (b < mn) mn = b
    sm = mx + mn; rg = mx - mn; l = sm / 2.0
    if (mn == mx) { h = 0 }
    else {
        rc = (mx - r) / rg; gc = (mx - g) / rg; bc = (mx - b) / rg
        if (r == mx) h = bc - gc
        else if (g == mx) h = 2.0 + rc - bc
        else h = 4.0 + gc - rc
        h = frac(h / 6.0)
    }
    s = amt
    if (s == 0) { r = l; g = l; b = l }
    else {
        m2 = (l <= 0.5) ? l * (1.0 + s) : l + s - (l * s)
        m1 = 2.0 * l - m2
        r = hlsv(m1, m2, h + 1/3); g = hlsv(m1, m2, h); b = hlsv(m1, m2, h - 1/3)
    }
    return hex(int(r * 255.0), int(g * 255.0), int(b * 255.0))
}
{ c[n++] = tolower($0) }
END {
    # si ImageMagick dio menos de 16, pywal repite la lista hasta llegar a 16
    base = n
    while (n < 16) { for (i = 0; i < base; i++) c[n + i] = c[i]; n += base }
    # raw_colors = cols[:1] + cols[8:16] + cols[8:-1]
    p[0] = c[0]
    for (i = 1; i <= 8; i++)  p[i] = c[i + 7]
    for (i = 9; i <= 15; i++) p[i] = c[i - 1]
    # generic_adjust (modo oscuro, sin --cols16)
    if (substr(p[0], 2, 1) != "0") p[0] = darken(p[0], 0.40)
    more = 0
    if (substr(p[0], 2, 1) == "0") more = 1
    if (substr(p[0], 4, 1) == "0") more = 1
    if (substr(p[0], 6, 1) == "0") more = 1
    if (more) { p[0] = lighten(p[0], 0.03); p[0] = saturate(p[0], 0.40) }
    p[7]  = lighten(p[0], 0.75)
    p[8]  = lighten(p[0], 0.35)
    p[8]  = saturate(p[8], 0.10)
    p[15] = p[7]
    for (i = 0; i <= 15; i++) print p[i]
}
'

# Llama a imagemagick como pywal: -resize 25% -colors N -unique-colors
# y si salen menos de 16 colores reintenta con 17, 18... hasta 35
gen_colors() {
    raw=""; n=0; i=0
    while [ "$i" -lt 20 ]; do
        raw=$($IM "${wal}[0]" -resize 25% -colors "$((16 + i))" \
              -unique-colors txt:- 2>/dev/null | grep -E -o '#[0-9a-fA-F]{6}')
        n=$(printf '%s\n' "$raw" | grep -c .)
        [ "$n" -ge 16 ] && break
        out "warning: only $n colors, trying $((17 + i))"
        i=$((i + 1))
    done
    [ "$n" -ge 1 ] || magick_error
    colors=$(printf '%s\n' "$raw" | awk "$ADJUST_AWK")
}

send_sequences() {
    set -- $colors
    [ -z "$1" ] && set -- "#000000" "#111111" "#222222" "#333333" "#444444" "#555555" "#666666" "#777777" "#888888" "#999999" "#aaaaaa" "#bbbbbb" "#cccccc" "#dddddd" "#eeeeee" "#ffffff"

    c0="$1"; c1="$2"; c2="$3"; c3="$4"; c4="$5"; c5="$6"; c6="$7"; c7="$8"
    c8="$9"; c9="${10}"; c10="${11}"; c11="${12}"; c12="${13}"; c13="${14}"; c14="${15}"; c15="${16}"

    mkdir -p ~/.cache
    {
        printf '%s\n' "$c15"
        printf '%s\n' "$c0"
        printf '%s\n' "$c15"
        printf '%s\n' "$c0"
        printf '%s\n' "$c1"
        printf '%s\n' "$c2"
        printf '%s\n' "$c3"
        printf '%s\n' "$c4"
        printf '%s\n' "$c5"
        printf '%s\n' "$c6"
        printf '%s\n' "$c7"
        printf '%s\n' "$c8"
        printf '%s\n' "$c9"
        printf '%s\n' "$c10"
        printf '%s\n' "$c11"
        printf '%s\n' "$c12"
        printf '%s\n' "$c13"
        printf '%s\n' "$c14"
        printf '%s\n' "$c15"
    } | tr -d '#' > "$CURRENT"

    paleta < "$CURRENT" > "$CURRENT.tmp" 2>/dev/null || paleta_error; mv "$CURRENT.tmp" "$CURRENT"
    out "colors: set terminal colors"
    out "background: $c0"
}

set_wallpaper() {
    if type feh >/dev/null 2>&1; then
        feh --bg-fill "$wal"
    elif type nitrogen >/dev/null 2>&1; then
        nitrogen --set-zoom-fill "$wal"
    elif type bgs >/dev/null 2>&1; then
        bgs "$wal"
    elif type hsetroot >/dev/null 2>&1; then
        hsetroot -fill "$wal"
    elif type habak >/dev/null 2>&1; then
        habak -mS "$wal"
    elif type wbg >/dev/null 2>&1; then
        killall wbg
        wbg -s "$wal" >/dev/null 2>&1 &
    elif type swaybg >/dev/null 2>&1; then
        killall swaybg
        swaybg -m fill -i "$wal" >/dev/null 2>&1 &
    fi
    out "wallpaper: set new wallpaper"
}

magick_check() {
    pallines=$(printf '%s\n' "$colors" | grep -c .)

    out "palette: palette lines '$pallines'"

    if [ "$pallines" -lt 16 ]; then
        magick_error
    fi
}

magick_error() {
    out "error: magick couldnt generate a palette, exiting..."
    exit 1
}

paleta_error() {
    out "error: paleta couldnt apply the palette, exiting..."
    exit 1
}

main() {
    [ -z "$1" ] && { printf '%s\n' "usage: bud <image.png/directory>"; exit 1; }

    wal=$(img "$1")
    if type magick >/dev/null 2>&1; then
        IM="magick"
    elif type convert >/dev/null 2>&1; then
        IM="convert"
    else
        out "error: imagemagick not found, exiting..."
        exit 1
    fi

    out "colors: using wallpaper '$wal'"

    gen_colors
    magick_check

    out "colors: generated colorscheme"

    send_sequences
    set_wallpaper
}

main "$@"
